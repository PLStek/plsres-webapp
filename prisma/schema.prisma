generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:.//database/plsres.db"
}

model Charbon {
    id             Int      @id @default(autoincrement())
    status         String   @default("SCHEDULED")
    isDraft        Boolean  @default(true)
    title          String
    description    String
    timestamp      DateTime
    replayUrl      String?  @unique
    courseId       Int
    discordEventId String   @unique

    resources   Resource[]
    actionneurs CharbonActionneur[]
    course      Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
    attendees   CharbonAttendee[]

    @@index(courseId)
    @@index(discordEventId)
}

model CharbonAttendee {
    id            Int    @id @default(autoincrement())
    charbonId     Int
    discordUserId String

    charbon Charbon @relation(fields: [charbonId], references: [id], onDelete: Cascade)

    @@unique([charbonId, discordUserId])
    @@index(charbonId)
    @@index(discordUserId)
}

model Course {
    id                       Int    @id @default(autoincrement())
    code                     String @unique
    title                    String
    discordResourceChannelId String @unique
    discordVoiceChannelId    String @unique

    category String
    charbon  Charbon[]

    @@index(discordVoiceChannelId)
}

model Resource {
    id        Int    @id @default(autoincrement())
    title     String
    charbonId Int
    extension String

    charbon Charbon @relation(fields: [charbonId], references: [id], onDelete: Cascade)

    @@index(charbonId)
}

model Actionneur {
    id         Int     @id @default(autoincrement())
    discordId  String  @unique
    username   String  @unique
    isAdmin    Boolean @default(false)
    isActive   Boolean @default(true)
    secretHash String

    charbons CharbonActionneur[]

    @@index(discordId)
}

model Invitation {
    id        Int      @id @default(autoincrement())
    token     String   @unique
    discordId String   @unique
    expiresAt DateTime

    @@index(token)
}

model CharbonActionneur {
    charbon   Charbon @relation(fields: [charbonId], references: [id], onDelete: Cascade)
    charbonId Int

    actionneur   Actionneur @relation(fields: [actionneurId], references: [id], onDelete: Cascade)
    actionneurId Int

    @@id([charbonId, actionneurId])
}

model RevokedToken {
    id        Int      @id @default(autoincrement())
    token     String   @unique
    expiresAt DateTime

    @@index(token)
}

model PendingAuth {
    id          Int      @id @default(autoincrement())
    discordId   String   @unique
    accessToken String   @unique
    expiresAt   DateTime

    @@index(discordId)
}
